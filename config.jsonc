// ~/.config/fastfetch/config.jsonc
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

  "logo": {
    "type": "data",
	"source": "       .--.       \n      |o_o |      \n      |:_/ |      \n     //   \\ \\     \n    (|     | )    \n   /'\\_   _/`\\    \n   \\___)=(___/    ",
    "color": {
      "1": "cyan"
    },
    "padding": {
      "right": 2
    }
  },

  "display": {
    "separator": "  ",
    "key": {
      "width": 14,
      "type": "string"
    }
  },

  "modules": [
    {
      "type": "title",
      "key": "╭─  user",
      "keyColor": "31",
      "format": "{user-name}"
    },

    {
      "type": "title",
      "key": "│ 󰇅 hname",
      "keyColor": "32",
      "format": "{host-name}"
    },

    {
      "type": "os",
      "key": "│ 󰣇 distro",
      "keyColor": "33",
      "format": "{name} {version}"
    },
    {
      "type": "kernel",
      "key": "│  kernel",
      "keyColor": "36"
    },

    {
      "type": "uptime",
      "key": "│ 󰅐 uptime",
      "keyColor": "34"
    },

    {
      "type": "shell",
      "key": "│  shell",
      "keyColor": "35"
    },

    {
      "type": "packages",
      "key": "│ 󰏖 pkgs",
      "keyColor": "31"
    },

    {
      "type": "memory",
      "key": "│ 󰍛 memory",
      "keyColor": "33",
      "format": "{used} / {total}"
    },

    {
      "type": "colors",
      "key": "╰─  colors",
      "keyColor": "39",
      "symbol": "circle"
    }
  ]
}
